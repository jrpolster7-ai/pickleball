# Copy this file to .env for local development. Never commit .env.

# Turn on for local development only.
DJANGO_DEBUG=true

# Required when DJANGO_DEBUG is off. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# Comma separated host names the site answers to.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma separated full origins, e.g. https://pickleball.example.com (production only).
DJANGO_CSRF_TRUSTED_ORIGINS=

# Leave unset to use local SQLite (db.sqlite3).
# Production example: postgres://user:password@host:5432/dbname
DATABASE_URL=

# How long players stay signed in, in seconds. Default is one year.
# SESSION_COOKIE_AGE=31536000

# Optional. Makes the first admin on deploy if no admin exists yet (see README).
# DJANGO_ADMIN_USERNAME=
# DJANGO_ADMIN_PASSWORD=

# Optional, production only. Turn on once the final domain works over HTTPS.
# DJANGO_HSTS_SECONDS=31536000
